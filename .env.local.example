# Supabase: copy this file to `.env.local` and fill in the values from
# your Supabase dashboard: Project Settings → API
#
# .env.local is gitignored, so your real keys are never committed.

# Project URL, e.g. https://qpjivpliwlyimurhhwse.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key: safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never
# use it in client code. Needed only for privileged admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Production URL (used for canonical links, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=https://www.abimbolaolumuyiwa.com

# ---------------------------------------------------------------------------
# Newsletter ("Stay Connected" form): pick ONE provider
#   brevo | mailchimp | convertkit | webhook | supabase
# Leave empty and the form politely says sign-ups aren't open yet.
# ---------------------------------------------------------------------------
NEWSLETTER_PROVIDER=

# Brevo:       Settings → SMTP & API → API keys; list id from Contacts → Lists
BREVO_API_KEY=
BREVO_LIST_ID=
# Mailchimp:   Account → Extras → API keys (key ends in -usXX); Audience → Settings → Audience ID
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# ConvertKit (Kit): Settings → Advanced → API key; form id from the form's URL
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=
# Webhook:     any URL that accepts a JSON POST (Zapier, Make, Formspree, …)
NEWSLETTER_WEBHOOK_URL=
# supabase:    stores sign-ups in the `subscribers` table (run supabase/migrations/0002_forms.sql)

# ---------------------------------------------------------------------------
# Contact form: webhook | supabase
# ---------------------------------------------------------------------------
CONTACT_PROVIDER=
# e.g. a Formspree endpoint (https://formspree.io/f/xxxx): emails you each message
CONTACT_WEBHOOK_URL=
